{
  "name": "yuantou-community",
  "version": "1.0.0",
  "private": true,
  "description": "源头社区小程序 - React + Taro",
  "template": "taro",
  "scripts": {
    "dev:weapp": "taro build --type weapp --watch",
    "build:weapp": "taro build --type weapp",
    "dev:h5": "taro build --type h5 --watch",
    "build:h5": "taro build --type h5 && node scripts/merge-css.js",
    "preview:h5": "npm run build:h5 && node scripts/merge-css.js && python3 -m http.server 8848 --directory dist",
    "gen:icons": "node scripts/gen-icons.js",
    "lint": "eslint --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "eslint --ext .ts,.tsx,.js,.jsx --fix"
  },
  "dependencies": {
    "@babel/preset-react": "^8.0.1",
    "@babel/preset-typescript": "^8.0.1",
    "@tarojs/components": "^4.0.0",
    "@tarojs/plugin-framework-react": "^4.0.0",
    "@tarojs/plugin-platform-h5": "^4.2.1",
    "@tarojs/plugin-platform-weapp": "^4.0.0",
    "@tarojs/react": "^4.0.0",
    "@tarojs/runtime": "^4.0.0",
    "@tarojs/taro": "^4.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "taro-ui": "^3.1.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@tarojs/cli": "^4.0.0",
    "@tarojs/webpack5-runner": "^4.0.0",
    "@types/react": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "autoprefixer": "^10.4.18",
    "babel-preset-taro": "^4.0.0",
    "css-loader": "^6.10.0",
    "eslint": "^8.57.0",
    "eslint-config-taro": "^4.0.0",
    "eslint-plugin-react": "^7.34.0",
    "postcss": "^8.4.35",
    "postcss-loader": "^8.1.1",
    "style-loader": "^3.3.4",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "webpack": "^5.78.0"
  },
  "browserslist": [
    "Android >= 5.0",
    "iOS >= 9.0"
  ]
}
